{
  "info": {
    "name": "Smart Medical Appointment & Risk Prediction System (BCSP-064)",
    "description": "Comprehensive Postman test suite for IGNOU BCA Major Project REST APIs (BCSP-064 by Preeti, Enrollment: 2401048429)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register Patient",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Preeti\",\n  \"email\": \"preeti@example.com\",\n  \"password\": \"Patient@123\",\n  \"mobile\": \"+91 9876543210\",\n  \"age\": 24,\n  \"gender\": \"Female\",\n  \"address\": \"Rohini, New Delhi\",\n  \"bloodGroup\": \"B+\",\n  \"medicalHistory\": \"None\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register/patient" }
          }
        },
        {
          "name": "Login (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usernameOrEmail\": \"admin\",\n  \"password\": \"Admin@123\",\n  \"role\": \"ADMIN\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login" }
          }
        },
        {
          "name": "Login (Doctor)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usernameOrEmail\": \"sharma@smartmed.com\",\n  \"password\": \"Doctor@123\",\n  \"role\": \"DOCTOR\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login" }
          }
        },
        {
          "name": "Login (Patient)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usernameOrEmail\": \"preeti@example.com\",\n  \"password\": \"Patient@123\",\n  \"role\": \"PATIENT\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login" }
          }
        }
      ]
    },
    {
      "name": "2. Patient Module",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/patients/me" }
          }
        },
        {
          "name": "Update My Profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Preeti\",\n  \"mobile\": \"+91 9876543210\",\n  \"age\": 25,\n  \"gender\": \"Female\",\n  \"address\": \"Sector 14, Rohini, New Delhi\",\n  \"bloodGroup\": \"B+\",\n  \"medicalHistory\": \"Seasonal Allergies\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/patients/me" }
          }
        },
        {
          "name": "List Doctors",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/doctors" }
          }
        },
        {
          "name": "Get Doctor Available Slots",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/doctors/1/slots" }
          }
        },
        {
          "name": "Book Appointment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctorId\": 1,\n  \"slotId\": 1,\n  \"reason\": \"Routine cardiology follow-up\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/appointments" }
          }
        },
        {
          "name": "Get My Appointments",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/patients/me/appointments" }
          }
        },
        {
          "name": "Reschedule Appointment",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"newSlotId\": 2\n}"
            },
            "url": { "raw": "{{baseUrl}}/appointments/1/reschedule" }
          }
        },
        {
          "name": "Cancel Appointment",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/appointments/1/cancel" }
          }
        },
        {
          "name": "Submit Risk Prediction",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"age\": 50,\n  \"symptoms\": [\"FEVER\", \"PROLONGED_COUGH\", \"HIGH_BLOOD_PRESSURE\"]\n}"
            },
            "url": { "raw": "{{baseUrl}}/risk-predictions" }
          }
        },
        {
          "name": "Get My Risk Reports",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/patients/me/risk-reports" }
          }
        }
      ]
    },
    {
      "name": "3. Doctor Module",
      "item": [
        {
          "name": "Get Doctor Profile",
