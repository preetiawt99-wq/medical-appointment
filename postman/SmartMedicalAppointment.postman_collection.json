              "raw": "{\n  \"slotDate\": \"2026-10-15\",\n  \"slotTime\": \"11:30:00\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/doctors/me/slots" }
          }
        },
        {
          "name": "Delete Doctor Slot",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/doctors/me/slots/1" }
          }
        },
        {
          "name": "Update Status (Confirm)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"CONFIRMED\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/appointments/1/status" }
          }
        },
        {
          "name": "Complete Consultation & Add Notes",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"COMPLETED\",\n  \"doctorNotes\": \"Patient examined. BP 130/85 mmHg. Continue low sodium diet and take prescribed medication. Review after 15 days.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/appointments/1/status" }
          }
        }
      ]
    },
    {
      "name": "4. Admin Module",
